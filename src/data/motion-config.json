{
  "complexDesktopQuery": "(min-width: 1024px) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
  "nativeScroll": true,
  "easing": {
    "ui": "cubic-bezier(.22,1,.36,1)",
    "reveal": "power3.out",
    "crossfade": "sine.inOut",
    "scrub": "none"
  },
  "hero": {
    "titleDurationMs": 700,
    "lineStaggerMs": 90,
    "titleYpx": 24,
    "desktopImageParallaxPercent": 3,
    "mobileImageParallaxPercent": 0
  },
  "chapter": {
    "durationMs": 750,
    "start": "top 82%",
    "scrubSeconds": 0.65
  },
  "booking": {
    "durationMs": 320,
    "xPx": 24,
    "reducedMotionDurationMs": 0
  },
  "glass": {
    "desktopBlurPx": 14,
    "mobileBlurPx": 8,
    "fallbackOpaque": true
  },
  "pin": {
    "enabled": true,
    "maxInstances": 1,
    "scrollDistanceSvh": 120,
    "touchEnabled": false
  },
  "reducedMotion": {
    "pin": false,
    "parallax": false,
    "autoplayVideo": false,
    "reveal": "immediate"
  },
  "season": {
    "enabled": false,
    "desktopCrossfadeMs": 900,
    "touchCrossfadeMs": 450,
    "reducedCrossfadeMs": 0,
    "default": "summer",
    "urlKey": "season",
    "storageKey": "memento-mountain-season",
    "lastRequestWins": true,
    "preserveBookingAndScroll": true
  }
}
